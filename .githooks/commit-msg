#!/bin/sh
# Conventional commits: type(scope)!: summary. Squash merges take the PR
# title, so CI checks that too.
first=$(head -n1 "$1")
case "$first" in Merge*|Revert*|fixup!*|squash!*) exit 0 ;; esac
echo "$first" | grep -Eq '^(feat|fix|docs|chore|refactor|perf|test|ci|build|style|revert)(\([a-z0-9._/-]+\))?!?: .+' && exit 0
echo "commit-msg: expected 'type(scope): summary', e.g. 'fix(optimizer): ...'" >&2
echo "  types: feat fix docs chore refactor perf test ci build style revert" >&2
exit 1
